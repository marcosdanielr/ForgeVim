{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "ignoreCommand": "node scripts/ignore-web-build.mjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
