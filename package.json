{
  "name": "forge-nvim",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @forge/web dev",
    "build": "pnpm --filter @forge/web build",
    "check": "pnpm --filter @forge/web check",
    "lint": "eslint apps/web",
    "format": "prettier --write apps/web package.json eslint.config.mjs .prettierrc.mjs",
    "format:check": "prettier --check apps/web package.json eslint.config.mjs .prettierrc.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@12.4.1"
}
