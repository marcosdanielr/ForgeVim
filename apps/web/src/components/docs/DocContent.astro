---
import DocSections from '@/components/docs/DocSections.astro';
import type { DocPage } from '@/lib/docs';
import { localeFromPath } from '@/lib/i18n';

import Languages from '../../../../../docs/languages.md';
import LanguagesPt from '../../content/docs/pt/languages.md';
interface Props {
  page: DocPage;
}
const { page } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const sources = {
  languages: locale === 'pt' ? LanguagesPt : Languages,
};
const Source = page.source ? sources[page.source] : undefined;
---

{
  Source ? (
    <div class="markdown-content">
      <Source />
    </div>
  ) : (
    <DocSections sections={page.sections} />
  )
}
