---
import Icon from '@/components/ui/Icon.astro';
import ProductShot from '@/components/ui/ProductShot.astro';
import { agentWorkflow } from '@/content/home';
import { pageLocale } from '@/i18n';
const { locale, t, path } = pageLocale(Astro.url.pathname);
const content = agentWorkflow[locale];
---

<section class="workflow-section" id="workflow">
  <div class="page-shell">
    <div class="section-topline">
      <span class="eyebrow">{t('workflow.eyebrow')}</span><span
        class="font-mono text-xs text-white/45">CODEX / CLAUDE CODE / GEMINI</span
      >
    </div>
    <div class="workflow-heading">
      <h2>{t('workflow.title')}<br /><span>{t('workflow.subtitle')}</span></h2><p>
        {t('workflow.body')}
      </p>
    </div>
    <div class="agent-explanation">
      {
        content.steps.map((step, index) => (
          <article>
            <>
              <span>0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <code>{step.command}</code>
            </>
          </article>
        ))
      }
    </div>
    <ProductShot src="/screenshots/review.png" alt={content.alt} caption={content.caption} />
    <a href={path('/docs/agents/')} class="workflow-link"
      >{t('workflow.link')} <Icon name="arrow" /></a
    >
  </div>
</section>
