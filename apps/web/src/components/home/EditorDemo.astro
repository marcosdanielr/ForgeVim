---
import { pageLocale } from '@/lib/i18n';
const { t } = pageLocale(Astro.url.pathname);
const lines = [
  { number: '1', text: 'local agents = require("forge.features.agents")', kind: 'normal' },
  { number: '2', text: '', kind: 'normal' },
  { number: '3', text: '-- One worktree per task.', kind: 'comment' },
  { number: '4', text: 'vim.keymap.set("n", "<leader>aa", function()', kind: 'normal' },
  { number: '5', text: '  agents.choose()', kind: 'added' },
  { number: '6', text: 'end, { desc = "Review agent changes" })', kind: 'added' },
  { number: '7', text: '', kind: 'normal' },
];
---

<div class="editor-demo" aria-label={t('demo.label')}>
  <div class="editor-title">
    <span class="inline-flex items-center gap-2"
      ><span class="size-1.5 bg-accent"></span> forge / search.lua</span
    ><span>worktree: search</span>
  </div>
  <div class="editor-tabs" role="tablist" aria-label={t('demo.tabs')}>
    <button
      id="tab-review"
      role="tab"
      aria-selected="true"
      aria-controls="demo-review"
      tabindex="0"
      data-demo-tab="review">01 <span>{t('demo.review')}</span></button
    >
    <button
      id="tab-debug"
      role="tab"
      aria-selected="false"
      aria-controls="demo-debug"
      tabindex="-1"
      data-demo-tab="debug">02 <span>Debug</span></button
    >
    <button
      id="tab-search"
      role="tab"
      aria-selected="false"
      aria-controls="demo-search"
      tabindex="-1"
      data-demo-tab="search">03 <span>{t('demo.search')}</span></button
    >
  </div>
  <div
    id="demo-review"
    role="tabpanel"
    aria-labelledby="tab-review"
    data-demo-panel="review"
    class="editor-panel"
  >
    <div class="editor-file">
      <span>search.lua</span><span class="text-accent">{t('demo.added')}</span>
    </div>
    <div class="editor-code">
      {
        lines.map((line) => (
          <div class:list={['code-line', line.kind]}>
            <>
              <span>{line.number}</span>
              <code>{line.text || ' '}</code>
            </>
          </div>
        ))
      }
    </div>
    <div class="review-prompt">
      <span class="status-dot"></span><div>
        <strong>{t('demo.ready')}</strong><p>{t('demo.control')}</p>
      </div><kbd>a</kbd>
    </div>
  </div>
  <div
    id="demo-debug"
    role="tabpanel"
    aria-labelledby="tab-debug"
    data-demo-panel="debug"
    class="editor-panel"
    hidden
  >
    <div class="editor-file">
      <span>handler.py</span><span class="text-accent">{t('demo.paused')}</span>
    </div>
    <div class="editor-code">
      <div class="code-line comment">
        <span>12</span><code># Breakpoint · request received</code>
      </div><div class="code-line added">
        <span>13</span><code>result = search(query, workspace)</code>
      </div><div class="code-line"><span>14</span><code>return result.matches</code></div>
    </div>
    <div class="debug-variables">
      <span>query</span><code>"review before apply"</code><span>workspace</span><code
        >"/project"</code
      ><span>matches</span><code>3</code>
    </div>
    <div class="review-prompt">
      <span class="status-dot"></span><div>
        <strong>{t('demo.inspect')}</strong><p>
          {t('demo.debugBody')}
        </p>
      </div><kbd>F10</kbd>
    </div>
  </div>
  <div
    id="demo-search"
    role="tabpanel"
    aria-labelledby="tab-search"
    data-demo-panel="search"
    class="editor-panel"
    hidden
  >
    <div class="editor-file"><span>LIVE GREP</span><span class="text-accent">ripgrep</span></div>
    <div class="demo-query">&gt; review<span class="cursor-block"></span></div>
    <div class="search-result">
      <span>core/service.py</span><code>def <mark>review</mark>(self, task_id):</code>
    </div><div class="search-result">
      <span>features/agents.lua</span><code>open_<mark>review</mark>(task)</code>
    </div><div class="search-result">
      <span>tests/lifecycle.py</span><code>test_<mark>review</mark>_before_accept()</code>
    </div>
    <div class="review-prompt">
      <span class="status-dot"></span><div>
        <strong>{t('demo.scope')}</strong><p>
          {t('demo.searchBody')}
        </p>
      </div><kbd>↵</kbd>
    </div>
  </div>
  <div class="editor-status">
    <span>NORMAL</span><span
      >main <span class="opacity-40">/</span> utf-8 <span class="opacity-40">/</span> lua</span
    ><span>5:28</span>
  </div>
</div>
