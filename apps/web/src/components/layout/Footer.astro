---
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { pageLocale } from '@/lib/i18n';
import { site } from '@/lib/site';
const { t, path } = pageLocale(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="page-shell flex flex-col justify-between gap-8 py-12 md:flex-row md:items-center">
    <div>
      <a href={path('/')} aria-label={t('nav.home')}><Logo /></a><p
        class="mt-4 text-sm text-ink-muted"
      >
        {t('footer.note')}
      </p>
    </div>
    <nav aria-label={t('nav.project')} class="flex flex-wrap gap-x-7 gap-y-4 text-sm font-semibold">
      <a href={path('/docs/')}>{t('nav.docs')}</a><a
        href={site.github}
        class="inline-flex items-center gap-2"
        target="_blank"
        rel="noopener noreferrer"><Icon name="github" class="size-4" /> GitHub</a
      >
      <a
        href={site.coffee}
        class="inline-flex items-center gap-2"
        target="_blank"
        rel="noopener noreferrer"><Icon name="coffee" class="size-4" /> Buy Me a Coffee</a
      >
    </nav>
  </div>
  <div
    class="page-shell flex flex-wrap justify-between gap-3 border-t border-line py-5 font-mono text-[10px] tracking-wide text-ink-muted"
  >
    <span>{t('footer.motto')}</span><span>{t('footer.version')}</span>
  </div>
</footer>
