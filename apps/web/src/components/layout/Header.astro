---
import Logo from '@/components/brand/Logo.astro';
import LanguageControl from '@/components/layout/LanguageControl.astro';
import ThemeControl from '@/components/layout/ThemeControl.astro';
import Icon from '@/components/ui/Icon.astro';
import { pageLocale } from '@/lib/i18n';
import { site } from '@/lib/site';
const { t, path } = pageLocale(Astro.url.pathname);
---

<header class="site-header">
  <div class="page-shell flex min-h-22 items-center justify-between gap-5">
    <a href={path('/')} aria-label={t('nav.home')}><Logo /></a>
    <nav class="hidden items-center gap-8 text-sm font-semibold md:flex" aria-label={t('nav.main')}>
      <a href={path('/#workflow')}>{t('nav.workflow')}</a><a href={path('/docs/')}
        >{t('nav.docs')}</a
      >
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2">GitHub <Icon name="github" class="size-4" /></a
      >
    </nav>
    <a href={path('/docs/')} class="button button-small button-primary hidden sm:inline-flex"
      >{t('nav.start')} <Icon name="arrow" class="size-4" /></a
    >
    <div class="header-preferences"><LanguageControl /><ThemeControl /></div>
    <details class="mobile-menu md:hidden">
      <summary aria-label={t('nav.mobile')}>Menu <span>+</span></summary><nav
        aria-label={t('nav.main')}
      >
        <a href={path('/#workflow')}>{t('nav.workflow')}</a><a href={path('/docs/')}
          >{t('nav.docs')}</a
        ><a href={site.github}>GitHub</a><a href={site.coffee}>Buy Me a Coffee</a>
      </nav>
    </details>
  </div>
</header>
