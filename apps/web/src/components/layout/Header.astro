---
import Logo from '@/components/brand/Logo.astro';
import LanguageControl from '@/components/layout/LanguageControl.astro';
import ThemeControl from '@/components/layout/ThemeControl.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { pageLocale } from '@/i18n';
const { t, path } = pageLocale(Astro.url.pathname);
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a href={path('/')} aria-label={t('nav.home')}><Logo /></a>
    <nav
      class="header-navigation hidden items-center gap-7 text-sm font-medium md:flex"
      aria-label={t('nav.main')}
    >
      <a href={path('/#workflow')}>{t('nav.workflow')}</a><a href={path('/docs/')}
        >{t('nav.docs')}</a
      >
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2">GitHub <Icon name="github" class="size-4" /></a
      >
    </nav>
    <div class="header-preferences">
      <LanguageControl /><ThemeControl /><a
        href={path('/docs/')}
        class="header-install hidden sm:inline-flex"
        >{t('nav.start')} <Icon name="arrow" class="size-3.5" /></a
      >
    </div>
    <details class="mobile-menu md:hidden">
      <summary aria-label={t('nav.mobile')}>Menu <span>+</span></summary><nav
        aria-label={t('nav.main')}
      >
        <a href={path('/#workflow')}>{t('nav.workflow')}</a><a href={path('/docs/')}
          >{t('nav.docs')}</a
        ><a href={site.github}>GitHub</a><a href={site.coffee}>Buy Me a Coffee</a>
      </nav>
    </details>
  </div>
</header>
