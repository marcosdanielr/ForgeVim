---
export type IconName = 'arrow' | 'github' | 'coffee' | 'copy' | 'check' | 'branch' | 'plus';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
const paths: Record<IconName, string> = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  github:
    'M9 19c-4.3 1.3-4.3-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 3.3-.4 6.5-1.6 6.5-7A5.4 5.4 0 0 0 19.5 5c.2-.8.2-2-.2-3 0 0-1.2-.4-3.8 1.4a13 13 0 0 0-7 0C5.9 1.6 4.7 2 4.7 2c-.4 1-.4 2.2-.2 3A5.4 5.4 0 0 0 3 8.5c0 5.4 3.2 6.6 6.5 7-.5.5-.6 1-.5 2V21',
  coffee: 'M4 8h13v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Zm13 1h2a3 3 0 1 1 0 6h-2M7 2v3m4-3v3m4-3v3',
  copy: 'M9 9h11v12H9zM5 15H3V3h11v2',
  check: 'm5 12 4 4L19 6',
  branch:
    'M6 6v12m12-12v3a4 4 0 0 1-4 4h-4M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 12a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  plus: 'M12 5v14M5 12h14',
};
---

<svg
  class={className}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg
>
