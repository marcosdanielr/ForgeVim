---
import DocContent from '@/components/docs/DocContent.astro';
import { getDocs } from '@/features/docs/content';
import DocsLayout from '@/layouts/DocsLayout.astro';
const page = (await getDocs('en'))[0];
if (!page) throw new Error('Getting started documentation is missing');
---

<DocsLayout page={page}><DocContent page={page} /></DocsLayout>
