---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Forge.nvim"
  ><main id="main" class="page-shell py-28">
    <p class="eyebrow">404 / PATH NOT FOUND</p><h1 class="mt-5 mb-8 text-5xl tracking-tight">
      That buffer does not exist.
    </h1><p class="mb-8 text-ink-muted">
      Return home or find what you need in the documentation.
    </p><ButtonLink href="/docs/" icon="arrow">Open documentation</ButtonLink>
  </main></BaseLayout
>
